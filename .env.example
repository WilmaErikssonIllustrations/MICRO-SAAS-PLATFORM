# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/micro-saas-platform"

# Better Auth: generate a secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# The platform's own domain (with port in development). Websites are served
# on <subdomain>.ROOT_DOMAIN and on custom domains pointed here via DNS.
ROOT_DOMAIN="localhost:3000"
# Optional: hostname customers point their CNAME at (defaults to ROOT_DOMAIN)
CUSTOM_DOMAIN_TARGET=""

# Image uploads (AWS S3). Uploads are disabled until all four are set.
# See README for the bucket's CORS rule and public-read policy.
AWS_REGION="eu-north-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET=""
# Optional: CDN/custom URL in front of the bucket (e.g. CloudFront)
S3_PUBLIC_URL=""
# Optional: endpoint for S3-compatible storage (Cloudflare R2, MinIO)
S3_ENDPOINT=""
