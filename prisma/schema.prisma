generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  websites      Website[]
}

// Session, Account and Verification are managed by Better Auth.
model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Each website is a tenant, served on its own subdomain and optionally on
// a custom domain the owner points at the platform via DNS.
model Website {
  id           String  @id @default(cuid())
  subdomain    String  @unique
  customDomain String? @unique

  // Site name, shared by every page (their root `title` prop).
  title     String
  // Uploaded fonts, shared by every page (their root `customFonts` prop).
  fonts     Json     @default("[]")
  // No longer used: the site's single page from before `Page`. Kept so
  // nothing is lost; its content was copied to the site's start page.
  data      Json     @default("{}")
  draft     Json?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages  Page[]

  @@index([userId])
}

// One page of a website, built in the Puck editor. The start page has the
// slug "" (the site's root); other pages live at /<slug>. "Publicera"
// publishes every page of the site at once.
model Page {
  id        String   @id @default(cuid())
  // "" for the start page, else lowercase words joined by "-".
  slug      String
  // The page's name in the editor, and its title in the browser.
  title     String
  // The published page (root props + blocks); {} until first published.
  data      Json     @default("{}")
  // Saved but unpublished edits; null when the editor matches `data`.
  draft     Json?
  // Order in the editor's page list.
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, slug])
  @@index([websiteId])
}
